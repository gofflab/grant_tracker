# ---------------------------------------------------------------------------
# Grant Tracker configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me-too

# Public address. A real hostname gets an automatic Let's Encrypt certificate
# (ports 80/443 must be reachable). "localhost" uses Caddy's local CA for testing.
SITE_ADDRESS=localhost
SITE_URL=https://localhost
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# First owner account, created on first start if no users exist.
# Remove the password from this file after you sign in and change it.
GT_OWNER_USERNAME=admin
GT_OWNER_PASSWORD=
GT_OWNER_EMAIL=
GT_OWNER_FIRST_NAME=
GT_OWNER_LAST_NAME=

# --- Optional -------------------------------------------------------------
SITE_NAME=Grant Tracker
TIME_ZONE=America/New_York
# Default "primary place of performance" on Current & Pending reports
INSTITUTION_NAME=
# Fiscal year start month for analytics (7 = July; 10 = federal FY)
FISCAL_YEAR_START_MONTH=7

# Security
REQUIRE_2FA=0
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
SESSION_COOKIE_AGE=43200
MAX_UPLOAD_MB=50

# Email (deadline digests, password reset). Leave EMAIL_HOST empty to disable.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Grant Tracker <grant-tracker@example.edu>

# Optional: AI help when importing an opportunity from an RFA link or PDF.
# Without a key, imports still use Grants.gov and pattern matching. With a key, the
# announcement text (public RFA content) is also sent to the Anthropic API, one call per
# import, billed to your key by length. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
OPPORTUNITY_AI_MODEL=claude-opus-5-5

# Reminder schedule (scheduler container)
REMINDER_HOUR=7
DIGEST_WEEKDAY=0
DAILY_URGENT_DIGEST=1
# Optional Slack incoming webhook for the weekly digest
SLACK_WEBHOOK_URL=

# Backups (backup container): nightly pg_dump of everything, including documents
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30

# Ports and TLS. To use your institution's certificate instead of Let's Encrypt:
#   CADDY_TLS=tls /certs/fullchain.pem /certs/privkey.pem   (and mount ./certs in docker-compose.yml)
HTTP_PORT=80
HTTPS_PORT=443
CADDY_TLS=

# Database names (defaults are fine)
POSTGRES_DB=grant_tracker
POSTGRES_USER=grant_tracker
